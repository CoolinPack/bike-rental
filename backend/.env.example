
# Required application settings
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
BOT_TOKEN=replace_me
SUPER_ADMIN_ID=123456789
WEBAPP_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example

# Telegram webhook
USE_WEBHOOK=false
WEBHOOK_URL=

# Storage: auto | cloudinary | s3 | local
# auto = Cloudinary when configured, otherwise S3 when configured, otherwise local.
STORAGE_BACKEND=auto
UPLOAD_DIR=./uploads

# Existing Cloudinary storage (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage (optional; AWS S3, Cloudflare R2, Backblaze B2 or MinIO)
S3_ENDPOINT_URL=
# Use auto for Cloudflare R2; use your actual region for AWS S3.
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN/custom domain or public bucket URL used by browsers to display media.
S3_PUBLIC_BASE_URL=
